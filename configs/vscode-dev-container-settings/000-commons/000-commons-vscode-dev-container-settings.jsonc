// Visual Studio Code Dev Container commons JSON file, for details refer to:
//  - https://containers.dev/implementors/json_reference/
//  - https://containers.dev/supporting
//  - https://containers.dev/supporting#dev-containers-cli
//  - https://containers.dev/implementors/spec/#devcontainerjson
// Do not edit manually — changes will be overwritten.
{
    // Point towards Docker Compose file with the 'dev-container' sentinel service to attach to.
    "dockerComposeFile": "./.manage-env/local-deps/pwsh-scripts/configs/docker-compose/010-vscode/000-dev-container-docker-compose.vscode.yml",
    "service": "dev-container",
    "workspaceFolder": "/dev-container-volume/vscode-workspace",
    // Disable all actions from the devcontainer, rely on Docker Bake and Docker Compose files.
    "shutdownAction": "none",
    "overrideCommand": false,
    "mounts": [],
    "runServices": [],
    // Do not run anything in any of the lifecycle hooks.
    "initializeCommand": {},
    "onCreateCommand": {},
    "updateContentCommand": {},
    "postCreateCommand": {},
    "postStartCommand": {},
    "postAttachCommand": {},
    // Users to use for from-the-host and from-the-container actions, the same user.
    "remoteUser": "devuser",
    "containerUser": "devuser"
}
