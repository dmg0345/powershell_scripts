# IceWM Programs Configuration File, for details, refer to: 
#   - https://ice-wm.org/man/icewm-programs

menu "Core Apps" folder {
    prog "Xfce4-terminal Terminal" xfce-terminal bash -c 'exec xfce4-terminal --default-working-directory="${HOME}"'
    prog "Thunar File Manager" system-file-manager bash -c 'exec thunar "${HOME}"'
    prog "Mousepad Text Editor" text-editor bash -c 'exec mousepad'
}

# Allow to load extra menu items dynamically from files.
include "/usr/share/icewm/00-programs-extra"
