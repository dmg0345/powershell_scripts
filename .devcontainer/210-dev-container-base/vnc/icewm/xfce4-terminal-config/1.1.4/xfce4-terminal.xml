<?xml version="1.1" encoding="UTF-8"?>

<!--
# xfce4-terminal configuration file, for details refer to:
#   - https://gitlab.xfce.org/apps/xfce4-terminal/-/blob/xfce4-terminal-1.1.4/terminal/terminal-preferences.c?ref_type=tags
#   - This file is also generated by configuring xfce4-terminal on the GUI, closing all instances and fetching '${HOME}/.config/xfce4/xfconf/xfce-perchannel-xml/xfce4-terminal.xml'.
-->

<channel name="xfce4-terminal" version="1.0">
    <property name="scrolling-on-output" type="bool" value="true"/>
    <property name="scrolling-unlimited" type="bool" value="true"/>
    <property name="misc-hyperlinks-enabled" type="bool" value="false"/>
    <property name="misc-right-click-action" type="string" value="TERMINAL_RIGHT_CLICK_ACTION_PASTE_SELECTION"/>
</channel>
