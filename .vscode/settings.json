{
    "[*]": {
        "editor.tabSize": 4
    },
    "[yaml]": {
        "editor.tabSize": 2
    },
    "breadcrumbs.enabled": false,
    "diffEditor.ignoreTrimWhitespace": false,
    "editor.autoIndent": "full",
    "editor.detectIndentation": false,
    "editor.formatOnSave": true,
    "editor.insertSpaces": true,
    "editor.minimap.enabled": false,
    "editor.quickSuggestions": {
        "comments": "off",
        "strings": "on"
    },
    "editor.renderWhitespace": "all",
    "editor.stickyScroll.enabled": false,
    "editor.trimAutoWhitespace": true,
    "explorer.autoReveal": false,
    "files.exclude": {
        "**/.git": true,
        "**/.manage-env": false,
        "**/__pycache__": true
    },
    "files.insertFinalNewline": true,
    "files.trimFinalNewlines": true,
    "files.trimTrailingWhitespace": true,
    "files.trimTrailingWhitespaceInRegexAndStrings": true,
    "git.openRepositoryInParentFolders": "never",
    "terminal.integrated.detectLocale": "off",
    "terminal.integrated.enablePersistentSessions": false,
    "terminal.integrated.hideOnLastClosed": false,
    "terminal.integrated.hideOnStartup": "never",
    "terminal.integrated.scrollback": 10000000,
    "terminal.integrated.stickyScroll.enabled": false,
    "terminal.integrated.tabs.focusMode": "singleClick",
    "terminal.integrated.tabs.hideCondition": "never",
    "workbench.colorTheme": "Default Dark Modern",
    "workbench.editor.enablePreview": false,
    "powershell.analyzeOpenDocumentsOnly": false,
    "powershell.buttons.showRunButtons": false,
    "powershell.codeFolding.enable": false,
    "powershell.codeFormatting.addWhitespaceAroundPipe": true,
    "powershell.codeFormatting.alignPropertyValuePairs": false,
    "powershell.codeFormatting.autoCorrectAliases": false,
    "powershell.codeFormatting.avoidSemicolonsAsLineTerminators": false,
    "powershell.codeFormatting.ignoreOneLineBlock": true,
    "powershell.codeFormatting.newLineAfterCloseBrace": true,
    "powershell.codeFormatting.newLineAfterOpenBrace": true,
    "powershell.codeFormatting.openBraceOnSameLine": false,
    "powershell.codeFormatting.pipelineIndentationStyle": "IncreaseIndentationForFirstPipeline",
    "powershell.codeFormatting.preset": "Custom",
    "powershell.codeFormatting.trimWhitespaceAroundPipe": false,
    "powershell.codeFormatting.useConstantStrings": false,
    "powershell.codeFormatting.useCorrectCasing": true,
    "powershell.codeFormatting.whitespaceAfterSeparator": true,
    "powershell.codeFormatting.whitespaceBeforeOpenBrace": true,
    "powershell.codeFormatting.whitespaceBeforeOpenParen": true,
    "powershell.codeFormatting.whitespaceBetweenParameters": false,
    "powershell.codeFormatting.whitespaceInsideBrace": true,
    "powershell.enableProfileLoading": true,
    "powershell.enableReferencesCodeLens": false,
    "powershell.integratedConsole.showOnStartup": true,
    "powershell.integratedConsole.startLocation": "Panel",
    "powershell.integratedConsole.suppressStartupBanner": true,
    "powershell.pester.codeLens": false,
    "powershell.pester.useLegacyCodeLens": false,
    "powershell.promptToUpdatePowerShell": false,
    "powershell.scriptAnalysis.enable": true,
    "powershell.scriptAnalysis.settingsPath": "${workspaceFolder}/.vscode/001-configs/000-config-pss-script-analyzer.psd1",
    "powershell.sideBar.CommandExplorerVisibility": false,
    "powershell.startAsLoginShell.linux": true,
    "powershell.startAsLoginShell.osx": true,
    "powershell.startAutomatically": true,
    "powershell.trace.server": "verbose",
    "github-actions.remote-name": "no-remote-ie-not-used",
    "github-actions.use-enterprise": false,
    "github-actions.workflows.pinned.refresh.enabled": false,
    "github-actions.workflows.pinned.refresh.interval": 10000000000,
    "github-actions.workflows.pinned.workflows": [],
    "git-log--graph.disable-commit-stats": true,
    "git-log--graph.disable-preliminary-loading": true,
    "git-log--graph.git-path": "git",
    "git-log--graph.hide-quick-branch-tips": false,
    "git-log--graph.hide-sidebar-buttons": false,
    "git-log--graph.position": "editor",
    "git-log--graph.show-inferred-quick-branch-tips": true,
    "shellcheck.customArgs": [
        "--norc",
        "--rcfile=${workspaceFolder}/.vscode/001-configs/000-config-shellcheck.rc"
    ],
    "shellcheck.disableVersionCheck": true,
    "shellcheck.enable": true,
    "shellcheck.executablePath": "",
    "shellcheck.run": "onType"
}
