// Visual Studio Code common settings file, for details refer to:
//   - https://code.visualstudio.com/docs/configure/settings#_workspace-settings
{
    // Override theme.
    "workbench.colorTheme": "Pwsh Darker",
    // Override render whitespace color.
    "workbench.colorCustomizations": {
        "editorWhitespace.foreground": "#202020"
    }
}
